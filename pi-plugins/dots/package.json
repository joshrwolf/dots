{
  "name": "@joshrwolf/pi-dots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Pi workflow extensions maintained in dots",
  "exports": {
    "./ui": "./src/index.ts"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "extensions/context/index.ts",
      "extensions/memory/index.ts",
      "extensions/workers/index.ts"
    ],
    "skills": [],
    "prompts": [],
    "themes": []
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node --experimental-strip-types --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": ">=1.3.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "22.19.15",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
