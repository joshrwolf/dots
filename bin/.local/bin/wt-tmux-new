#!/bin/sh
# Open a new tmux window in the current worktree, named after the branch
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || basename "$PWD")
COUNT=$(tmux list-windows -F '#{window_name}' | grep -c "^${BRANCH}")
if [ "$COUNT" -gt 0 ]; then
	NAME="${BRANCH}:$((COUNT + 1))"
else
	NAME="$BRANCH"
fi
tmux new-window -n "$NAME" -c "$PWD"
