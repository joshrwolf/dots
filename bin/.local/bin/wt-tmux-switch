#!/bin/sh
# Switch to a worktree via wt picker, open in a new tmux window
BRANCH=$(wt switch --no-cd) || exit 0
[ -z "$BRANCH" ] && exit 0
WTP=$(git worktree list --porcelain | awk -v b="refs/heads/$BRANCH" '
	/^worktree / {p=$2}
	$0=="branch "b {print p; exit}
')
[ -z "$WTP" ] && exit 0
wt-tmux-open "$BRANCH" "$WTP"
