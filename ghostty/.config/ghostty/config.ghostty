# Application settings stay here. The selected palette is shared through the
# central theme package so changing themes does not require editing this file.
config-file = theme.ghostty
window-decoration = none

# Translate macOS shortcuts into Herdr's Ctrl+S prefix chords.
keybind = cmd+p=text:\x13P
keybind = cmd+o=text:\x13O
keybind = cmd+t=text:\x13t
keybind = cmd+h=text:\x13h
keybind = cmd+j=text:\x13j
keybind = cmd+k=text:\x13k
keybind = cmd+l=text:\x13l

# Reorder Herdr tabs with Cmd+Shift+H/L (prefix + Alt+H/L).
keybind = cmd+shift+h=text:\x13\x1bh
keybind = cmd+shift+l=text:\x13\x1bl

# Resize Herdr panes without entering resize mode.
keybind = ctrl+shift+h=text:\x13H
keybind = ctrl+shift+j=text:\x13J
keybind = ctrl+shift+k=text:\x13K
keybind = ctrl+shift+l=text:\x13L
