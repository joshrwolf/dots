.DS_Store
.idea/
.envrc

# Machine-local configuration; omitted from fresh clones.
/sesh/
/starship/
/git/
/fzf/
/claude/
/bin/
/tmux/
/worktrunk/
/tools/

**/*.old
**/*hide.lua
**/keys/

# Game audio; this repo is public
herdr/.config/herdr/sounds/*.mp3

# nvim writes here when started with -V*/path logging.
nvim.log

# Built plugin binaries. `make` builds them into each plugin directory so a
# plugin can stand alone, but the artifact itself is never checked in.
herdr-plugins/target/
herdr-plugins/*/bin/


# Pi package build/dependency artifacts and local runtime data.
pi-plugins/**/node_modules/
pi-plugins/**/dist/
pi-plugins/**/dist-pkg/
pi-plugins/**/coverage/
pi-plugins/**/.pi/
pi-plugins/**/*.tgz
pi-plugins/**/__pycache__/
scripts/__pycache__/

# Scratch handoff notes, not part of the dotfiles.
herdr-plugins/HANDOFF.md

# Standalone Herdr handoff binary staged before optional Stow installation.
herdr/.local/bin/herdr-issue
herdr/.local/bin/herdr-issue.tmp.*
