{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.1",
    "path": ["?.lua", "?/init.lua"]
  },
  "workspace": {
    "library": ["types"],
    "checkThirdParty": false
  },
  "diagnostics": {
    "groupSeverity": { "strong": "Warning", "strict": "Warning" }
  }
}
