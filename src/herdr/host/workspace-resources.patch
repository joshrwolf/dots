diff --git a/src/app/api/resources.rs b/src/app/api/resources.rs
new file mode 100644
index 0000000..9a9c1bd
--- /dev/null
+++ b/src/app/api/resources.rs
@@ -0,0 +1,129 @@
+use super::responses::{encode_error, encode_success};
+use crate::api::schema::{PluginActionInvokeParams, ResponseResult, WorkspaceTarget};
+use crate::app::App;
+use crate::workspace_resources::{Invoke, Replace, WorkspaceResources};
+use std::time::Instant;
+
+impl App {
+    pub(super) fn handle_resources_get(&mut self, id: String, target: WorkspaceTarget) -> String {
+        let Some(index) = self.parse_workspace_id(&target.workspace_id) else {
+            return encode_error(id, "workspace_not_found", "workspace not found");
+        };
+        let Some(workspace) = self.state.workspaces.get(index) else {
+            return encode_error(id, "workspace_not_found", "workspace not found");
+        };
+        encode_success(
+            id,
+            ResponseResult::WorkspaceResources {
+                resources: WorkspaceResources {
+                    workspace_id: workspace.id.clone(),
+                    identity: workspace.identity.to_string(),
+                    collections: workspace.resources.values(Instant::now()),
+                },
+            },
+        )
+    }
+
+    pub(super) fn handle_resources_replace(&mut self, id: String, request: Replace) -> String {
+        let Some(index) = self.parse_workspace_id(&request.workspace_id) else {
+            return encode_error(id, "workspace_not_found", "workspace not found");
+        };
+        if self
+            .state
+            .workspaces
+            .get(index)
+            .is_none_or(|workspace| workspace.identity.to_string() != request.identity)
+        {
+            return encode_error(
+                id,
+                "workspace_identity_mismatch",
+                "workspace lifetime changed",
+            );
+        }
+        if let Err(error) = self.refresh_installed_plugins() {
+            return encode_error(id, "plugin_registry_load_failed", error.to_string());
+        }
+        if !self
+            .state
+            .installed_plugins
+            .get(&request.plugin_id)
+            .is_some_and(|plugin| plugin.enabled)
+        {
+            return encode_error(
+                id,
+                "invalid_resource_producer",
+                "resource producer must be an enabled installed plugin",
+            );
+        }
+        for resource in &request.resources {
+            match self.find_plugin_action(Some(&request.plugin_id), &resource.action) {
+                Ok((plugin, _)) if plugin.enabled => {}
+                _ => {
+                    return encode_error(
+                        id,
+                        "invalid_resource_action",
+                        "resource action must belong to an enabled installed plugin",
+                    )
+                }
+            }
+        }
+        let Some(workspace) = self.state.workspaces.get_mut(index) else {
+            return encode_error(id, "workspace_not_found", "workspace not found");
+        };
+        match workspace.resources.replace(request, Instant::now()) {
+            Ok(collection) => {
+                self.sync_agent_metadata_deadline();
+                encode_success(
+                    id,
+                    ResponseResult::WorkspaceResourcesReplaced { collection },
+                )
+            }
+            Err(error) => encode_error(id, "resource_replace_failed", error),
+        }
+    }
+
+    pub(super) fn handle_resources_invoke(&mut self, id: String, request: Invoke) -> String {
+        let Some(index) = self.parse_workspace_id(&request.workspace_id) else {
+            return encode_error(id, "workspace_not_found", "workspace not found");
+        };
+        let Some(workspace) = self
+            .state
+            .workspaces
+            .get(index)
+            .filter(|workspace| workspace.identity.to_string() == request.identity)
+        else {
+            return encode_error(
+                id,
+                "workspace_identity_mismatch",
+                "workspace lifetime changed",
+            );
+        };
+        let Some(resource) = workspace
+            .resources
+            .get(
+                &request.plugin_id,
+                request.revision,
+                &request.resource_id,
+                Instant::now(),
+            )
+            .cloned()
+        else {
+            return encode_error(
+                id,
+                "resource_changed",
+                "resource changed or expired; refresh before invoking",
+            );
+        };
+        let mut context = self.plugin_context_for_workspace(index, &id);
+        context.clicked_url = Some(resource.reference);
+        context.invocation_source = Some("workspace_resource".into());
+        self.handle_plugin_action_invoke(
+            id,
+            PluginActionInvokeParams {
+                plugin_id: Some(request.plugin_id),
+                action_id: resource.action,
+                context: Some(context),
+            },
+        )
+    }
+}
