+                plugin_id: request.plugin_id.clone(),
+            }),
+        });
+        assert!(
+            app.state.workspaces[0].resources.values(Instant::now())[&request.plugin_id]
+                .resources
+                .is_empty()
+        );
+        let mut late = request;
