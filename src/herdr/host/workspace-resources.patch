diff --git a/src/workspace_resources.rs b/src/workspace_resources.rs
new file mode 100644
index 0000000..abf44e3
--- /dev/null
+++ b/src/workspace_resources.rs
@@ -0,0 +1,278 @@
+//! Plugin-owned resource collections. Runtime facts, independent of any client layout.
+use std::collections::{BTreeMap, HashSet};
+use std::time::{Duration, Instant};
+
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct Resource {
+    pub id: String,
+    pub label: String,
+    pub status: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub detail: Option<ResourceDetail>,
+    #[serde(default)]
+    pub tone: Tone,
+    #[serde(default)]
+    pub completed: bool,
+    /// Action declared by the collection's installed plugin.
+    pub action: String,
+    /// Opaque resource reference passed as clicked_url to the declared action.
+    pub reference: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+pub struct ResourceDetail {
+    pub text: String,
+    pub tone: Tone,
+}
+
+#[derive(
+    Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema,
+)]
+#[serde(rename_all = "snake_case")]
+pub enum Tone {
+    #[default]
+    Normal,
+    Success,
+    Warning,
+    Failure,
+    Muted,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct Replace {
+    pub workspace_id: String,
+    pub identity: String,
+    pub plugin_id: String,
+    pub expected_revision: u64,
+    pub ttl_ms: u64,
+    pub resources: Vec<Resource>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct Invoke {
+    pub workspace_id: String,
+    pub identity: String,
+    pub plugin_id: String,
+    pub resource_id: String,
+    pub revision: u64,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+pub struct Collection {
+    pub revision: u64,
+    pub resources: Vec<Resource>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+pub struct WorkspaceResources {
+    pub workspace_id: String,
+    pub identity: String,
+    pub collections: BTreeMap<String, Collection>,
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct Collections {
+    entries: BTreeMap<String, Entry>,
+}
+
+#[derive(Debug)]
+struct Entry {
+    collection: Collection,
+    expires: Instant,
+}
+
+impl Collections {
+    pub(crate) fn clear_source(&mut self, source: &str) {
+        if let Some(entry) = self.entries.get_mut(source) {
+            entry.collection.resources.clear();
+        }
+    }
+
+    pub(crate) fn replace(&mut self, request: Replace, now: Instant) -> Result<Collection, String> {
+        validate(&request)?;
+        let revision = self
+            .entries
+            .get(&request.plugin_id)
+            .map_or(0, |entry| entry.collection.revision);
+        if request.expected_revision != revision {
+            return Err("resource collection revision changed".into());
+        }
+        if self.entries.len() >= 32 && !self.entries.contains_key(&request.plugin_id) {
+            return Err("too many resource producers".into());
+        }
+        let collection = Collection {
+            revision: revision
+                .checked_add(1)
+                .ok_or("resource revision exhausted")?,
+            resources: request.resources,
+        };
+        let expires = now
+            .checked_add(Duration::from_millis(request.ttl_ms))
+            .ok_or("resource expiry overflow")?;
+        self.entries.insert(
+            request.plugin_id,
+            Entry {
+                collection: collection.clone(),
+                expires,
+            },
+        );
+        Ok(collection)
+    }
+
+    pub(crate) fn values(&self, now: Instant) -> BTreeMap<String, Collection> {
+        self.entries
+            .iter()
+            .map(|(source, entry)| {
+                let mut collection = entry.collection.clone();
+                if now >= entry.expires {
+                    collection.resources.clear();
+                }
+                (source.clone(), collection)
+            })
+            .collect()
+    }
+
+    pub(crate) fn get(
+        &self,
+        source: &str,
+        revision: u64,
+        id: &str,
+        now: Instant,
+    ) -> Option<&Resource> {
+        let entry = self.entries.get(source)?;
+        (entry.expires > now && entry.collection.revision == revision)
+            .then(|| entry.collection.resources.iter().find(|item| item.id == id))
+            .flatten()
+    }
+
+    pub(crate) fn expire(&mut self, now: Instant) -> bool {
+        let mut changed = false;
+        for entry in self.entries.values_mut() {
+            if entry.expires <= now && !entry.collection.resources.is_empty() {
+                entry.collection.resources.clear();
+                changed = true;
+            }
+        }
+        changed
+    }
+
+    pub(crate) fn next_expiry(&self) -> Option<Instant> {
+        self.entries
+            .values()
+            .filter(|entry| !entry.collection.resources.is_empty())
+            .map(|entry| entry.expires)
+            .min()
+    }
+}
+
+fn text(value: &str, max: usize) -> bool {
+    !value.trim().is_empty() && value.len() <= max && !value.chars().any(char::is_control)
+}
+
+pub(crate) fn validate(request: &Replace) -> Result<(), String> {
+    if !text(&request.plugin_id, 128)
+        || request.resources.len() > 512
+        || !(1..=86_400_000).contains(&request.ttl_ms)
+    {
+        return Err("invalid resource producer, item count, or TTL".into());
+    }
+    let mut ids = HashSet::new();
+    for item in &request.resources {
+        if !text(&item.id, 256)
+            || !text(&item.label, 512)
+            || !text(&item.status, 512)
+            || item
+                .detail
+                .as_ref()
+                .is_some_and(|detail| !text(&detail.text, 512))
+            || !text(&item.action, 128)
+            || !text(&item.reference, 2048)
+            || !ids.insert(&item.id)
+        {
+            return Err("invalid or duplicate resource".into());
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn replacement(revision: u64) -> Replace {
+        Replace {
+            workspace_id: "w1".into(),
+            identity: "identity".into(),
+            plugin_id: "example".into(),
+            expected_revision: revision,
+            ttl_ms: 1000,
+            resources: vec![Resource {
+                id: "one".into(),
+                label: "cafe\u{301} 👨‍👩‍👧".into(),
+                status: "Pending".into(),
+                detail: None,
+                tone: Tone::Normal,
+                completed: false,
+                action: "open".into(),
+                reference: "https://example.invalid/item/1".into(),
+            }],
+        }
+    }
+    #[test]
+    fn atomic_replacement_fences_stale_updates_and_expired_actions() {
+        let now = Instant::now();
+        let mut store = Collections::default();
+        store.replace(replacement(0), now).unwrap();
+        assert!(store.replace(replacement(0), now).is_err());
+        let mut invalid = replacement(1);
+        invalid.resources.push(invalid.resources[0].clone());
+        assert!(store.replace(invalid, now).is_err());
+        assert!(store.get("example", 1, "one", now).is_some());
+        assert!(store
+            .get("example", 1, "one", now + Duration::from_secs(2))
+            .is_none());
+        assert!(store.expire(now + Duration::from_secs(2)));
+        assert_eq!(store.values(now)["example"].revision, 1);
+        assert!(store.replace(replacement(1), now).is_ok());
+    }
+}
+
+pub(crate) const PROJECTION_KIND: &str = "endpoint.workspace-resources.v1";
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub(crate) struct Projection {
+    pub boot_id: String,
+    pub revision: u64,
+    pub workspaces: Vec<WorkspaceResources>,
+}
+
+pub(crate) fn project(state: &crate::app::AppState) -> Vec<WorkspaceResources> {
+    let now = Instant::now();
+    state
+        .workspaces
+        .iter()
+        .map(|workspace| WorkspaceResources {
+            workspace_id: workspace.id.clone(),
+            identity: workspace.identity.to_string(),
+            collections: workspace.resources.values(now),
+        })
+        .collect()
+}
+
+pub(crate) fn message(
+    boot_id: &str,
+    revision: u64,
+    workspaces: Vec<WorkspaceResources>,
+) -> Result<crate::protocol::ServerMessage, serde_json::Error> {
+    Ok(crate::protocol::ServerMessage::EndpointControl {
+        kind: PROJECTION_KIND.into(),
+        data: serde_json::to_string(&Projection {
+            boot_id: boot_id.into(),
+            revision,
+            workspaces,
+        })?,
+    })
+}
