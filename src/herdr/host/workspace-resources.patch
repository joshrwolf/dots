+impl ClientShellState {
+    pub(crate) fn set_workspace_resources(
+        &mut self,
+        id: &ClientEndpointId,
+        generation: u64,
+        projection: crate::workspace_resources::Projection,
+    ) {
+        let Some(endpoint) = self
+            .endpoints
+            .iter_mut()
+            .find(|endpoint| &endpoint.endpoint_id == id)
+        else {
+            return;
+        };
+        if endpoint
+            .snapshot_generation
+            .is_some_and(|current| current > generation)
+        {
+            return;
+        }
+        if endpoint
+            .resources
+            .iter()
+            .chain(endpoint.pending_resources.iter())
+            .any(|(current, previous)| {
+                *current > generation
+                    || (*current == generation
+                        && previous.boot_id == projection.boot_id
+                        && previous.revision > projection.revision)
+            })
+        {
+            return;
+        }
+        if endpoint.snapshot_generation == Some(generation)
+            && endpoint.snapshot.as_ref().is_some_and(|snapshot| {
+                snapshot.boot_id == projection.boot_id && snapshot.revision == projection.revision
+            })
+        {
+            endpoint.resources = Some((generation, projection));
+        } else {
+            endpoint.pending_resources = Some((generation, projection));
+        }
+    }
+}
