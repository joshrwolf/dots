index 0000000..d2ff1ac
--- /dev/null
+++ b/src/client/shell/resource_tree.rs
@@ -0,0 +1,603 @@
+//! A flat navigable projection of workspace resources, with one scroll unit per line.
+use super::render::put_text;
+use super::*;
+use crate::workspace_resources::{Invoke, Resource, Tone};
+
+#[derive(Clone, Debug)]
+pub(super) enum ResourceTarget {
+    Invoke(Invoke),
+    Group { workspace_id: String, key: String },
+}
+
+impl PartialEq for ResourceTarget {
+    fn eq(&self, other: &Self) -> bool {
+        match (self, other) {
+            (Self::Invoke(a), Self::Invoke(b)) => {
+                a.workspace_id == b.workspace_id
+                    && a.identity == b.identity
+                    && a.plugin_id == b.plugin_id
+                    && a.resource_id == b.resource_id
+            }
+            (
+                Self::Group {
+                    workspace_id: a,
+                    key: ak,
+                },
+                Self::Group {
+                    workspace_id: b,
+                    key: bk,
+                },
+            ) => a == b && ak == bk,
+            _ => false,
+        }
+    }
+}
+impl Eq for ResourceTarget {}
+
+pub(super) fn children(
+    endpoint: &ClientShellEndpoint,
+    workspace_id: &str,
+    collapsed: &HashSet<String>,
+) -> Vec<ResourceTarget> {
+    let Some(resources) = endpoint
+        .workspace_resources()
+        .iter()
+        .find(|resources| resources.workspace_id == workspace_id)
+    else {
+        return Vec::new();
+    };
+    let key = format!("resources-expanded:{}", resources.identity);
+    let mut open = Vec::new();
+    let mut completed = Vec::new();
+    for (plugin_id, collection) in &resources.collections {
+        for item in &collection.resources {
+            let target = ResourceTarget::Invoke(Invoke {
+                workspace_id: workspace_id.into(),
+                identity: resources.identity.clone(),
+                plugin_id: plugin_id.clone(),
+                resource_id: item.id.clone(),
+                revision: collection.revision,
+            });
+            if item.completed {
+                completed.push(target)
+            } else {
+                open.push(target)
+            }
+        }
+    }
+    if !completed.is_empty() {
+        open.push(ResourceTarget::Group {
+            workspace_id: workspace_id.into(),
+            key: key.clone(),
+        });
+        if collapsed.contains(&key) {
+            open.extend(completed);
+        }
+    }
+    open
+}
+
+#[derive(Clone)]
+pub(super) struct ResourceHit {
+    pub rect: Rect,
+    pub endpoint: ClientEndpointId,
+    pub target: ResourceTarget,
+}
+
+enum Row<'a> {
+    Endpoint(&'a ClientShellEndpoint),
+    Workspace {
+        endpoint: &'a ClientShellEndpoint,
+        workspace: &'a ClientShellWorkspace,
+        entry: WorkspaceEntry,
+    },
+    Resource {
+        endpoint: &'a ClientShellEndpoint,
+        target: ResourceTarget,
+        item: &'a Resource,
+        indent: u16,
+    },
+    Completed {
+        endpoint: &'a ClientShellEndpoint,
+        target: ResourceTarget,
+        count: usize,
+        expanded: bool,
+        indent: u16,
+    },
+}
+
+fn rows<'a>(state: &'a render::ShellRenderState<'_>) -> Vec<Row<'a>> {
+    let mut rows = Vec::new();
+    for endpoint in state.endpoints {
+        if state.endpoints.len() > 1 {
+            rows.push(Row::Endpoint(endpoint));
+        }
+        if state.collapsed_endpoints.contains(&endpoint.endpoint_id) {
+            continue;
+        }
+        let Some(snapshot) = endpoint.snapshot.as_deref() else {
+            continue;
+        };
+        let empty = HashSet::new();
+        let collapsed = if &endpoint.endpoint_id == state.active_endpoint_id {
+            state.collapsed_groups
+        } else {
+            state
+                .remote_collapsed_groups
+                .get(&endpoint.endpoint_id)
+                .unwrap_or(&empty)
+        };
+        for entry in sidebar::workspace_entries(snapshot, collapsed) {
+            let Some(workspace) = snapshot.workspaces.get(entry.index) else {
+                continue;
+            };
+            let indent = if entry.indented { 8 } else { 3 };
+            rows.push(Row::Workspace {
+                endpoint,
+                workspace,
+                entry,
+            });
+            let Some(resources) = endpoint
+                .workspace_resources()
+                .iter()
+                .find(|resource| resource.workspace_id == workspace.workspace_id)
+            else {
+                continue;
+            };
+            let mut completed = Vec::new();
+            for (plugin_id, collection) in &resources.collections {
+                for item in &collection.resources {
+                    let row = Row::Resource {
+                        endpoint,
+                        item,
+                        indent,
+                        target: ResourceTarget::Invoke(Invoke {
+                            workspace_id: workspace.workspace_id.clone(),
+                            identity: resources.identity.clone(),
+                            plugin_id: plugin_id.clone(),
+                            resource_id: item.id.clone(),
+                            revision: collection.revision,
+                        }),
+                    };
+                    if item.completed {
+                        completed.push(row);
+                    } else {
+                        rows.push(row);
+                    }
+                }
+            }
+            if !completed.is_empty() {
+                let key = format!("resources-expanded:{}", resources.identity);
+                let expanded = collapsed.contains(&key);
+                rows.push(Row::Completed {
+                    endpoint,
+                    target: ResourceTarget::Group {
+                        workspace_id: workspace.workspace_id.clone(),
+                        key,
+                    },
+                    count: completed.len(),
+                    expanded,
+                    indent,
+                });
+                if expanded {
+                    rows.extend(completed);
+                }
+            }
+        }
+    }
+    rows
+}
+
+pub(super) fn available(state: &render::ShellRenderState<'_>) -> bool {
+    state.endpoints.iter().any(|endpoint| {
+        endpoint.workspace_resources().iter().any(|workspace| {
+            workspace
+                .collections
+                .values()
+                .any(|collection| !collection.resources.is_empty())
+        })
+    })
+}
+
+pub(super) fn render_body(
+    buffer: &mut Buffer,
+    body: Rect,
+    config: &ClientShellConfig,
+    state: &mut render::ShellRenderState<'_>,
+    hits: &mut ShellHitMap,
+) {
+    let rows = rows(state);
+    let palette = &config.palette;
+    let heights: Vec<u16> = rows
+        .iter()
+        .map(|row| match row {
+            Row::Workspace {
+                workspace, entry, ..
+            } => u16::try_from(
+                sidebar::workspace_rows(
+                    workspace,
+                    workspace.agent_status,
+                    entry.indented,
+                    &config.spaces,
+                )
+                .len()
+                .max(1),
+            )
+            .unwrap_or(u16::MAX),
+            Row::Resource { item, .. } if item.detail.is_some() => 2,
+            _ => 1,
+        })
+        .collect();
+    let gaps = vec![0; rows.len()];
+    let mut offset = *state.workspace_scroll;
+    if *state.reveal_navigation_workspace || *state.reveal_focused_workspace {
+        if let Some(index) = rows.iter().position(|row| match row {
+            Row::Workspace {
+                endpoint,
+                workspace,
+                ..
+            } => state.selected_workspace_id.map_or(
+                workspace.focused && &endpoint.endpoint_id == state.active_endpoint_id,
+                |target| target.matches(&endpoint.endpoint_id, &workspace.workspace_id),
+            ),
+            Row::Resource {
+                endpoint, target, ..
+            }
+            | Row::Completed {
+                endpoint, target, ..
+            } => state.selected_workspace_id.is_some_and(|selected| {
+                selected.endpoint_id == endpoint.endpoint_id
+                    && selected.resource.as_ref() == Some(target)
+            }),
+            Row::Endpoint(_) => false,
+        }) {
+            offset =
+                scroll::list_scroll_start_to_reveal(&heights, &gaps, body.height, offset, index);
+        }
+    }
+    let metrics = scroll::list_scroll_metrics(&heights, &gaps, body.height, offset);
+    offset = metrics
+        .max_offset_from_bottom
+        .saturating_sub(metrics.offset_from_bottom);
+    let width = body
+        .width
+        .saturating_sub(u16::from(metrics.max_offset_from_bottom > 0));
+    let mut y = body.y;
+    for (row, height) in rows.iter().zip(&heights).skip(offset) {
+        let height = (*height).min(body.height);
+        if y.saturating_add(height) > body.bottom() {
+            break;
+        }
+        let rect = Rect::new(body.x, y, width, height);
+        y = y.saturating_add(height);
+        match row {
+            Row::Endpoint(endpoint) => {
+                let marker = if state.collapsed_endpoints.contains(&endpoint.endpoint_id) {
+                    "▸"
+                } else {
+                    "▾"
+                };
+                let status_badge = super::endpoint_sidebar::render_endpoint_row(
+                    buffer,
+                    rect,
+                    marker,
+                    endpoint,
+                    state.collapsed_endpoints.contains(&endpoint.endpoint_id)
+                        && &endpoint.endpoint_id == state.active_endpoint_id,
+                    state.machine_diagnostics,
+                    palette,
+                );
+                hits.machines.push(MachineHit {
+                    rect,
+                    status_badge,
+                    collapse_toggle: Rect::new(
+                        rect.x.saturating_add(1),
+                        rect.y,
+                        u16::from(rect.width > 1),
+                        1,
+                    ),
+                    endpoint_id: endpoint.endpoint_id.clone(),
+                });
+            }
+            Row::Workspace {
+                endpoint,
+                workspace,
+                entry,
+            } => {
+                let selected = state.selected_workspace_id.is_some_and(|target| {
+                    target.matches(&endpoint.endpoint_id, &workspace.workspace_id)
+                });
+                let dragged = &endpoint.endpoint_id == state.active_endpoint_id
+                    && state.dragged_workspace_id == Some(workspace.workspace_id.as_str());
+                sidebar::render_workspace_rows(
+                    buffer,
+                    rect,
+                    workspace.agent_status,
+                    config.status_indicators,
+                    entry,
+                    sidebar::workspace_rows(
+                        workspace,
+                        workspace.agent_status,
+                        entry.indented,
+                        &config.spaces,
+                    ),
+                    workspace.focused,
+                    selected,
+                    state.selected_workspace_id.is_some(),
+                    dragged,
+                    palette,
+                );
+                let group_toggle = endpoint.snapshot.as_deref().and_then(|snapshot| {
+                    let empty = HashSet::new();
+                    let collapsed = if &endpoint.endpoint_id == state.active_endpoint_id {
+                        state.collapsed_groups
+                    } else {
+                        state
+                            .remote_collapsed_groups
+                            .get(&endpoint.endpoint_id)
+                            .unwrap_or(&empty)
+                    };
+                    sidebar::render_parent_group_toggle(
+                        buffer,
+                        rect,
+                        snapshot,
+                        entry.index,
+                        collapsed,
+                        palette,
+                    )
+                });
+                hits.workspaces.push(WorkspaceHit {
+                    rect,
+                    endpoint_id: endpoint.endpoint_id.clone(),
+                    workspace_id: workspace.workspace_id.clone(),
+                    indented: entry.indented,
+                    group_toggle,
+                });
+            }
+            Row::Resource {
+                endpoint,
+                item,
+                target,
+                indent,
+            } => {
+                let tone_color = |tone| match tone {
+                    Tone::Normal => palette.text,
+                    Tone::Success => palette.green,
+                    Tone::Warning => palette.yellow,
+                    Tone::Failure => palette.red,
+                    Tone::Muted => palette.overlay0,
+                };
+                let fg = tone_color(item.tone);
+                let selected = state.selected_workspace_id.is_some_and(|selected| {
+                    selected.endpoint_id == endpoint.endpoint_id
+                        && selected.resource.as_ref() == Some(target)
+                });
+                let style = if selected {
+                    Style::default()
+                        .fg(fg)
+                        .bg(sidebar::workspace_selection_background(palette))
+                } else {
+                    Style::default().fg(fg)
+                };
+                buffer.set_style(rect, style);
+                render_item(
+                    buffer,
+                    rect,
+                    *indent,
+                    item,
+                    style,
+                    palette.text,
+                    item.detail
+                        .as_ref()
+                        .map_or(palette.text, |detail| tone_color(detail.tone)),
+                );
+                hits.resources.push(ResourceHit {
+                    rect,
+                    endpoint: endpoint.endpoint_id.clone(),
+                    target: target.clone(),
+                });
+            }
+            Row::Completed {
+                endpoint,
+                target,
+                count,
+                expanded,
+                indent,
+            } => {
+                if state.selected_workspace_id.is_some_and(|selected| {
+                    selected.endpoint_id == endpoint.endpoint_id
+                        && selected.resource.as_ref() == Some(target)
+                }) {
+                    buffer.set_style(
+                        rect,
+                        Style::default().bg(sidebar::workspace_selection_background(palette)),
+                    );
+                }
+                put_text(
+                    buffer,
+                    rect.x.saturating_add(*indent),
+                    rect.y,
+                    rect.width.saturating_sub(*indent),
+                    &format!("{} {count} completed", if *expanded { "▾" } else { "▸" }),
+                    Style::default().fg(palette.overlay0),
+                );
+                hits.resources.push(ResourceHit {
+                    rect,
+                    endpoint: endpoint.endpoint_id.clone(),
+                    target: target.clone(),
+                });
+            }
+        }
+    }
+    drop(rows);
+    *state.workspace_scroll = offset;
+    *state.reveal_navigation_workspace = false;
+    *state.reveal_focused_workspace = false;
+    hits.workspace_max_scroll = metrics.max_offset_from_bottom;
+    hits.workspace_scroll_metrics = Some(metrics);
+    if metrics.max_offset_from_bottom > 0 && body.width > 1 {
+        hits.workspace_scrollbar =
+            Rect::new(body.right().saturating_sub(1), body.y, 1, body.height);
+        scroll::render_list_scrollbar(buffer, hits.workspace_scrollbar, metrics, palette);
+    }
+}
+
+impl ClientShellState {
+    pub(super) fn activate_resource(
+        &mut self,
+        endpoint: ClientEndpointId,
+        target: ResourceTarget,
+        outcome: &mut ClientShellInput,
+    ) {
+        match target {
+            ResourceTarget::Group { key, .. } => self.toggle_collapsed_group(&endpoint, key),
+            ResourceTarget::Invoke(request) => {
+                let Some(source) = self.endpoints.iter().find(|source| {
+                    source.endpoint_id == endpoint && source.status == ClientEndpointStatus::Online
+                }) else {
+                    return;
+                };
+                let Some(snapshot) = source.snapshot.as_deref() else {
+                    return;
+                };
+                let Some(collection) = source
+                    .workspace_resources()
+                    .iter()
+                    .find(|items| {
+                        items.identity == request.identity
+                            && items.workspace_id == request.workspace_id
+                    })
+                    .and_then(|items| items.collections.get(&request.plugin_id))
+                else {
+                    return;
+                };
+                if !collection
+                    .resources
+                    .iter()
+                    .any(|item| item.id == request.resource_id)
+                {
+                    return;
+                }
+                let mut request = request;
+                request.revision = collection.revision;
+                let method = crate::api::schema::Method::WorkspaceResourcesInvoke(request);
+                let id = format!("client-shell:{}", self.next_request_id);
+                self.next_request_id = self.next_request_id.saturating_add(1);
+                self.pending_requests.insert(
+                    id.clone(),
+                    PendingEndpointRequest {
+                        boot_id: snapshot.boot_id.clone(),
+                        method_name: "workspace.resources.invoke".into(),
+                        confirmation_workspace_id: None,
+                        kind: PendingEndpointKind::Generic,
+                    },
+                );
+                outcome.actions.push(ClientShellAction::Endpoint {
+                    endpoint_id: endpoint,
+                    boot_id: snapshot.boot_id.clone(),
+                    request: Box::new(crate::api::schema::Request { id, method }),
+                });
+            }
+        }
+        outcome.repaint = true;
+    }
+}
+
+fn render_item(
+    buffer: &mut Buffer,
+    rect: Rect,
+    indent: u16,
+    item: &Resource,
+    style: Style,
+    label_color: ratatui::style::Color,
+    detail_color: ratatui::style::Color,
+) {
+    let x = rect.x.saturating_add(indent);
+    let width = rect.width.saturating_sub(indent);
+    let label_width = render::display_width(&item.label)
+        .saturating_add(2)
+        .min(width);
+    put_text(buffer, x, rect.y, width, &item.label, style.fg(label_color));
+    put_text(
+        buffer,
+        x.saturating_add(label_width),
+        rect.y,
+        width.saturating_sub(label_width),
+        &item.status,
+        style,
+    );
+    if let Some(detail) = &item.detail {
+        if rect.height > 1 {
+            put_text(
+                buffer,
+                x.saturating_add(label_width),
+                rect.y + 1,
+                width.saturating_sub(label_width),
+                &detail.text,
+                style.fg(detail_color),
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+mod layout_tests {
+    use super::*;
+    use crate::workspace_resources::ResourceDetail;
+    use ratatui::style::Color;
+
+    #[test]
+    fn compact_pr_keeps_approval_and_checks_separate_at_narrow_widths() {
+        let item = Resource {
+            id: "pr".into(),
+            label: "#12345".into(),
+            status: "✓ Approved".into(),
+            tone: Tone::Success,
+            completed: false,
+            action: "open".into(),
+            reference: "pr".into(),
+            detail: Some(ResourceDetail {
+                text: "◷ 2 checks".into(),
+                tone: Tone::Warning,
+            }),
+        };
+        for width in [26, 28, 32, 40] {
+            let rect = Rect::new(0, 0, width, 2);
+            let mut buffer = Buffer::empty(rect);
+            render_item(
+                &mut buffer,
+                rect,
+                8,
+                &item,
+                Style::default().fg(Color::Green),
+                Color::White,
+                Color::Yellow,
+            );
+            let line = |y| {
+                (0..width)
+                    .map(|x| buffer[(x, y)].symbol())
+                    .collect::<String>()
+            };
+            assert!(line(0).contains("#12345  ✓ Approved"));
+            assert!(line(1).contains("◷ 2 checks"));
+            assert_eq!(buffer[(8, 0)].fg, Color::White);
+            assert_eq!(buffer[(16, 0)].fg, Color::Green);
+            assert_eq!(buffer[(16, 1)].fg, Color::Yellow);
+        }
+        let mut unicode = item;
+        unicode.label = "cafe\u{301} 👨‍👩‍👧".into();
+        for width in 0..32 {
+            let rect = Rect::new(0, 0, width, 2);
+            let mut buffer = Buffer::empty(rect);
+            render_item(
+                &mut buffer,
+                rect,
+                8,
+                &unicode,
+                Style::default(),
+                Color::White,
+                Color::Yellow,
+            );
+        }
+    }
+}
