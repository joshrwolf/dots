+            identity: workspace.identity.to_string(),
+            plugin_id: "example.worktree-bootstrap".into(),
+            expected_revision: 0,
+            ttl_ms: 120000,
+            resources: vec![Resource {
+                id: "pr-1".into(),
+                label: "#1".into(),
+                status: "Pending".into(),
+                detail: None,
+                tone: Tone::Normal,
