+impl ClientShellEndpoint {
+    pub(super) fn workspace_resources(&self) -> &[crate::workspace_resources::WorkspaceResources] {
+        let Some((generation, projection)) = self.resources.as_ref() else {
+            return &[];
+        };
+        if self.snapshot_generation != Some(*generation)
+            || !self.snapshot.as_deref().is_some_and(|snapshot| {
+                snapshot.boot_id == projection.boot_id && snapshot.revision == projection.revision
+            })
+        {
+            return &[];
+        }
+        &projection.workspaces
+    }
+}
