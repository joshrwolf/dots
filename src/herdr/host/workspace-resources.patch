+
+fn resource_projection(
+    snapshot: &ClientShellSnapshot,
+    count: usize,
+) -> crate::workspace_resources::Projection {
+    use crate::workspace_resources::*;
+    Projection {
+        boot_id: snapshot.boot_id.clone(),
+        revision: snapshot.revision,
+        workspaces: vec![WorkspaceResources {
+            workspace_id: "ws_1".into(),
+            identity: "bd2f97a9-bcc5-432c-8f39-7b44692bac2e".into(),
+            collections: std::collections::BTreeMap::from([(
+                "example".into(),
+                Collection {
+                    revision: snapshot.revision,
+                    resources: (0..count)
+                        .map(|index| Resource {
+                            id: format!("pr-{index}"),
+                            label: format!("#{index} cafe\u{301} 👨‍👩‍👧"),
+                            status: "CI running".into(),
+                            detail: Some(ResourceDetail {
+                                text: "◷ 2 checks".into(),
+                                tone: Tone::Warning,
+                            }),
+                            tone: Tone::Warning,
+                            completed: index == count - 1,
+                            action: "open".into(),
+                            reference: format!("https://example.invalid/pr/{index}"),
+                        })
+                        .collect(),
+                },
+            )]),
+        }],
+    }
+}
+
+#[test]
+fn resource_navigation_scrolls_every_item_and_keeps_selection_across_updates() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    let mut snapshot = workspaces(1);
+    state.set_endpoint_snapshot_for_generation(
+        &ClientEndpointId::Local,
+        1,
+        Box::new(snapshot.clone()),
+    );
+    state.set_workspace_resources(
+        &ClientEndpointId::Local,
+        1,
+        resource_projection(&snapshot, 45),
+    );
+    state.set_pane_surface(surface());
+    state.compose(100, 28).unwrap();
+    enter_navigation(&mut state);
+    for index in 0..44 {
+        preview_key(&mut state, b"\x1b[B");
+        state.compose(100, 28).unwrap();
+        let selected = state
+            .navigate_workspace_id
+            .as_ref()
+            .unwrap()
+            .resource
+            .as_ref()
+            .unwrap();
+        let super::super::super::resource_tree::ResourceTarget::Invoke(request) = selected else {
+            panic!("expected PR")
+        };
+        assert_eq!(request.resource_id, format!("pr-{index}"));
+        assert!(state
+            .hits
+            .resources
+            .iter()
+            .any(|hit| &hit.target == selected));
+    }
+    assert!(state.hits.resources.iter().any(|hit| hit.rect.height == 2));
+    let selected = state.navigate_workspace_id.clone();
+    snapshot.revision += 1;
+    state.set_workspace_resources(
+        &ClientEndpointId::Local,
+        1,
+        resource_projection(&snapshot, 45),
+    );
+    // Companion arrives before its snapshot: retain the last coherent rows.
+    assert_eq!(state.endpoints[0].workspace_resources().len(), 1);
+    let mut frame = surface();
+    frame.projection_revision = snapshot.revision;
+    state.set_endpoint_snapshot_for_generation(&ClientEndpointId::Local, 1, Box::new(snapshot));
+    state.set_pane_surface(frame);
+    assert_eq!(state.navigate_workspace_id, selected);
+    let mut outcome = ClientShellInput::default();
+    state.accept_navigate_workspace(&mut outcome);
+    assert!(
+        matches!(outcome.actions.first(), Some(ClientShellAction::Endpoint {request, ..}) if matches!(&request.method, crate::api::schema::Method::WorkspaceResourcesInvoke(request) if request.resource_id == "pr-43"))
+    );
+    preview_key(&mut state, b"\x1b[B");
+    let mut outcome = ClientShellInput::default();
+    state.accept_navigate_workspace(&mut outcome); // expand completed group
+    assert!(outcome.actions.is_empty());
+    preview_key(&mut state, b"\x1b[B");
+    state.compose(100, 28).unwrap();
+    assert!(state.hits.resources.iter().any(|hit| matches!(&hit.target, super::super::super::resource_tree::ResourceTarget::Invoke(request) if request.resource_id == "pr-44")));
+}
+
+#[test]
+fn both_resource_lines_click_the_same_pr() {
+    for line in 0..2 {
+        let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+        let snapshot = workspaces(1);
+        state.set_endpoint_snapshot_for_generation(
+            &ClientEndpointId::Local,
+            1,
+            Box::new(snapshot.clone()),
+        );
+        state.set_workspace_resources(
+            &ClientEndpointId::Local,
+            1,
+            resource_projection(&snapshot, 2),
+        );
+        state.set_pane_surface(surface());
+        state.compose(100, 28).unwrap();
+        let hit = state.hits.resources.first().unwrap().clone();
+        assert_eq!(hit.rect.height, 2);
+        let outcome = state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: hit.rect.x + 10,
+            row: hit.rect.y + line,
+            modifiers: KeyModifiers::empty(),
+        })]);
+        assert!(outcome.actions.iter().any(|action| matches!(action,
+            ClientShellAction::Endpoint { request, .. } if matches!(&request.method,
+                crate::api::schema::Method::WorkspaceResourcesInvoke(request) if request.resource_id == "pr-0"))));
+    }
+}
