{
  "name": "@joshrwolf/pi-dots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Pi workflow extensions maintained in dots",
  "exports": {
    "./ui": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "extensions/anthropic-request-guard/index.ts",
      "extensions/context/index.ts",
      "extensions/ui/index.ts",
      "extensions/memory/index.ts",
      "extensions/workers/index.ts",
      "extensions/wake/index.ts",
      "extensions/jobs/index.ts",
      "extensions/goal/index.ts",
      "extensions/rex/index.ts",
      "extensions/status/index.ts"
    ],
    "skills": [],
    "prompts": [],
    "themes": [
      "themes/dots-light.json",
      "themes/dots-dark.json"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.{ts,mjs}\"",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.4.0",
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0",
    "typebox": "*"
  },
  "dependencies": {
    "@joshrwolf/pi-kit": "workspace:*",
    "diff": "9.0.0",
    "shiki": "4.5.0"
  }
}
