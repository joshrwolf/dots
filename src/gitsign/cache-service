#!/bin/sh
set -eu

# The cache performs authentication itself, so retain its URLs and diagnostics.
umask 077
log_dir="$HOME/Library/Logs/gitsign"
log_file="$log_dir/credential-cache.log"
mkdir -p "$log_dir"
chmod 700 "$log_dir"
touch "$log_file"
chmod 600 "$log_file"
exec >>"$log_file" 2>&1

exec /opt/homebrew/bin/gitsign-credential-cache
